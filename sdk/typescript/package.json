{
	"name": "@horon-ai/agent-sdk",
	"version": "0.1.0",
	"description": "TypeScript SDK for the horon-agent harness API (protocol v1)",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun run build && bun test",
		"check": "bun run typecheck && bun run test",
		"clean": "rm -rf dist",
		"prepack": "bun run clean && bun run build",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3"
	},
	"keywords": [
		"horon-agent",
		"agent",
		"sdk",
		"llm",
		"coding-agent",
		"harness-api"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/horon-ai/agent.git",
		"directory": "sdk/typescript"
	},
	"homepage": "https://github.com/horon-ai/agent/tree/dev/sdk/typescript#readme",
	"bugs": {
		"url": "https://github.com/horon-ai/agent/issues"
	},
	"author": "horon-ai",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"ajv": "^8.20.0"
	},
	"optionalDependencies": {
		"@horon-ai/agent-darwin-arm64": "0.1.0",
		"@horon-ai/agent-darwin-x64": "0.1.0",
		"@horon-ai/agent-linux-arm64": "0.1.0",
		"@horon-ai/agent-linux-x64": "0.1.0",
		"@horon-ai/agent-win32-arm64": "0.1.0",
		"@horon-ai/agent-win32-x64": "0.1.0"
	}
}
