/target
Cargo.lock
__pycache__/
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/dev/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
/.horon/generated-images/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# docs/ and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png

# Local agent workspace state (plans/evidence) - never committed in the fork.
.omo/
# Hyper tool output and per-project caches.
.hyper/
.senpi/
.herdr-web-ui/
# A root-level `agent` symlink to a temporary checkout was committed by
# accident once; keep local links like it out of the repository.
/agent
